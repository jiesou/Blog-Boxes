<!--
  Collapse — 折叠内容区。
  这里负责 mask 渐隐视觉过渡。
-->
<div class="relative min-h-0 w-full group/mask">
  <div
    class="h-full w-full
           [--fade:64px] group-has-checked/mask:[--fade:0px]
           mask-[linear-gradient(to_bottom,black_calc(100%-var(--fade)),transparent)]
           transition-[--fade] duration-300 ease-in-out
           group-hover/mask:[--fade:24px]
           group-has-checked/mask:pb-2"
  >
    <slot />
  </div>

  <label
    class="swap absolute w-full cursor-pointer -bottom-1.5 group/expand
          h-full group-has-checked/mask:h-15
          flex items-end justify-center
          *:text-sm *:font-bold *:text-accent"
  >
    <input type="checkbox" class="hidden" />
    <span
      class="swap-on absolute
             group-has-checked/mask:delay-200
             group-hover/expand:underline"
      >收起</span
    >
  </label>
</div>

<style is:global>
  @property --fade {
    syntax: "<length>";
    inherits: false;
    initial-value: 0px;
  }
</style>

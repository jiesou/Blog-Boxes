<!--
  Collapse — 折叠内容区。
  这里负责 mask 渐隐视觉过渡。
-->
<div class="relative min-h-0 w-full group/mask">
  <div
    class="h-full w-full
           [--fade:64px] group-has-checked/mask:[--fade:0px]
           mask-[linear-gradient(to_bottom,black_calc(100%-var(--fade)),transparent)]
           transition-[--fade] duration-300 ease-in-out
           group-hover/mask:[--fade:24px]
           group-has-checked/mask:pb-2"
  >
    <slot />
  </div>

  <label
    class="swap absolute w-full cursor-pointer -bottom-1 group/expand
           h-full group-has-checked/mask:h-15
           flex items-end justify-center
           *:text-sm *:font-bold *:text-accent"
    data-collapse-toggle
  >
    <input type="checkbox" />
    <span
      class="swap-on absolute
             group-has-checked/mask:delay-200
             group-hover/expand:underline"
      >收起</span
    >
  </label>
</div>

<style is:global>
  @property --fade {
    syntax: "<length>";
    inherits: false;
    initial-value: 0px;
  }

  [data-collapse-toggle]:has(:checked) {
    visibility: visible;
    pointer-events: auto;
  }
</style>

<script>
  for (const toggle of document.querySelectorAll("[data-collapse-toggle]") as unknown as HTMLElement[]) {
    const card = toggle.closest(".postcard-card") as HTMLElement | null;
    if (!card) continue;

    const mask = toggle.previousElementSibling as HTMLElement;
    const checkbox = toggle.querySelector<HTMLInputElement>("input");

    const show = () => { toggle.style.visibility = toggle.style.pointerEvents = ""; };
    const hide = () => { toggle.style.visibility = "hidden"; toggle.style.pointerEvents = "none"; };

    // Show expand button when the card can reveal more content
    const update = () => {
      if (checkbox?.checked) return show();
      // if (card.scrollHeight > card.clientHeight) return show();  // content overflows card
      if (mask.scrollHeight > mask.clientHeight) return show();  // mask hides content
      if (card.querySelector("img.cover-img")) return show(); // cover image may crop
      hide();
    };

    new ResizeObserver(update).observe(card);

    // Images may affect layout, re-check after they load
    for (const img of card.querySelectorAll("img"))
      if (!img.complete) img.addEventListener("load", update, { once: true });

    checkbox?.addEventListener("change", update);
    update();
  }
</script>

---
import type { Post } from "../types";
import PostCard from "./PostCard.astro";

interface Props {
  items: Post[];
}

const { items } = Astro.props;
---

<div class="p-10 max-md:p-6.5">
  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5 xl:gap-10 grid-flow-dense">
    {items.map((post) => (
      <PostCard post={post} />
    ))}
  </div>
</div>

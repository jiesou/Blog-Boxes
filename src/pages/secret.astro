---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Encrypter } from "age-encryption";
import * as age from "age-encryption";
import PostsSection from "../components/PostsSection.astro";
import { getSortedPosts, makeSlug } from "../lib/posts";

const boxes = import.meta.glob("../../boxes/*.md", {
  eager: true,
}) as Record<string, any>;
const { allPosts, secret, contributions } = await getSortedPosts(boxes);

const token = process.env.BOXES_SECRET_TOKEN || "changeme";
if (!process.env.BOXES_SECRET_TOKEN)
  console.warn("⚠ BOXES_SECRET_TOKEN not set, using 'changeme'");

const encryptedData: { slug: string; armored: string }[] = [];
for (const { post } of secret) {
  const slug = makeSlug(post.frontmatter);
  const e = new Encrypter();
  e.setScryptWorkFactor(12);
  e.setPassphrase(token);
  const ciphertext = await e.encrypt(await post.compiledContent());
  encryptedData.push({ slug, armored: age.armor.encode(ciphertext) });
}

const items = allPosts.map((r) =>
  r.post.frontmatter.secret ? { ...r, bodyHtml: "" } : r
);
---

<BaseLayout contributions={contributions}>
  <PostsSection items={items} />

  {encryptedData.length > 0 && (
    <script type="application/json" id="secret-data" is:inline set:html={JSON.stringify(encryptedData)}></script>
  )}
  <script>
    import { Decrypter } from "age-encryption";
    import * as age from "age-encryption";

     (async () => {
       const el = document.getElementById("secret-data");
       if (!el) return;

       const data = JSON.parse(el.textContent || "");
       if (!data.length) return;

        const token = prompt("secret?");
       if (!token) return;

        const d = new Decrypter();
        d.addPassphrase(token);
        for (const { slug, armored } of data)
          try {
            const raw = age.armor.decode(armored);
            const html = await d.decrypt(raw, "text");
            const target = document.querySelector(`[data-encrypted="${slug}"]`);
            if (target) target.innerHTML = html;
          } catch (err) {
            alert("decrypt failed: " + (err as Error).message);
            break;
          }
    })();
  </script>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostsSection from "../components/PostsSection.astro";
import { getSortedPosts } from "../lib/posts";

const boxes = import.meta.glob("../../boxes/*.md", {
  eager: true,
}) as Record<string, any>;
const { publicPosts, contributions } = await getSortedPosts(boxes);
---

<BaseLayout contributions={contributions}>
  <PostsSection items={publicPosts} />
</BaseLayout>

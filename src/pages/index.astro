---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostsSection from "../components/PostsSection.astro";
import { getPosts, getContributions } from "../lib/posts";

const [posts, contributions] = await Promise.all([
  getPosts(),
  getContributions(),
]);
const publicPosts = posts.filter((r) => !r.frontmatter.secret);
---

<BaseLayout contributions={contributions}>
  <PostsSection items={publicPosts} />
</BaseLayout>
